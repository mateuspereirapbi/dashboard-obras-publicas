ue="300"/><column index="28" value="300"/><column index="29" value="81"/><column index="30" value="300"/><column index="31" value="300"/><column index="32" value="300"/><column index="33" value="103"/><column index="34" value="39"/><column index="35" value="239"/><column index="36" value="300"/><column index="37" value="300"/><column index="38" value="101"/><column index="39" value="300"/><column index="40" value="300"/><column index="41" value="300"/><column index="42" value="300"/><column index="43" value="62"/><column index="44" value="127"/><column index="45" value="118"/><column index="46" value="74"/><column index="47" value="98"/><column index="48" value="101"/><column index="49" value="63"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">-- 1. VIEW: RANKING DOS MAIORES EMPREITEIROS DO PAÍS
CREATE VIEW IF NOT EXISTS vw_top_empreiteiros AS
SELECT 
    adjudicatario,
    COUNT(idcontrato) AS num_obras_ganhas,
    ROUND(SUM(precocontratual), 2) AS valor_total_adjudicado,
    RANK() OVER (ORDER BY SUM(precocontratual) DESC) AS ranking_nacional
FROM fact_empreitadas
WHERE adjudicatario IS NOT NULL AND adjudicatario != 'None'
GROUP BY adjudicatario;

-- 2. VIEW: EVOLUÇÃO MENSAL E CRESCIMENTO MOM
CREATE VIEW IF NOT EXISTS vw_evolucao_mensal AS
WITH acumulado_mensal AS (
    SELECT 
        mes_ano,
        COUNT(idcontrato) AS total_obras,
        ROUND(SUM(precocontratual), 2) AS investimento_mes
    FROM fact_empreitadas
    WHERE mes_ano IS NOT NULL
    GROUP BY mes_ano
)
SELECT 
    mes_ano,
    total_obras,
    investimento_mes,
    LAG(investimento_mes, 1) OVER (ORDER BY mes_ano) AS investimento_mes_anterior,
    ROUND(
        ((investimento_mes - LAG(investimento_mes, 1) OVER (ORDER BY mes_ano)) / 
        LAG(investimento_mes, 1) OVER (ORDER BY mes_ano)) * 100, 2
    ) AS variacao_percentual_mom
FROM acumulado_mensal;</sql><current_tab id="0"/></tab_sql></sqlb_project>
